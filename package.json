{
	"name": "gantt-for-bases",
	"version": "1.0.0",
	"description": "Gantt chart view for Bases",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"author": "Lukas Ellemunt",
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"gantt",
		"bases"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"jsdom": "^31.0.0",
		"obsidian": "^1.14.4",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"frappe-gantt": "1.2.2"
	}
}
